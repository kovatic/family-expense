# Set automatically when you connect a Neon (Vercel Postgres) database in Vercel.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me


# Optional
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY=INR

# --- Bank auto-import from Gmail (optional; see README "Bank auto-import") ---
# OAuth client from Google Cloud Console (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Defaults to <site origin>/api/integrations/gmail/callback when empty.
GOOGLE_REDIRECT_URI=
# Encrypts stored Gmail tokens. 32 random bytes: openssl rand -base64 32
# If empty, a key is derived from AUTH_SECRET.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Protects the daily sync endpoint. Vercel sends it automatically to cron jobs.
CRON_SECRET=
# Scheduled sync skips members synced more recently than this.
GMAIL_SYNC_INTERVAL_MINUTES=5
# How far back the first sync after connecting looks.
GMAIL_BACKFILL_DAYS=30
